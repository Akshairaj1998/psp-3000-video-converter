<!--
	Player
-->
	<VIEW id="vPlayer" width="859" height="468"
		minWidth="859" minHeight="468"
		resizable="true"
		titleBar="false"
		backgroundColor="none"
		timerInterval="4000"
		onTimer="JScript:OnTimerTransport();"
		onLoad="OnLoad();"
		onClose="OnClose();"
		scriptFile="Corona.js;metadata.js;res://wmploc.dll/RT_TEXT/#132">

		<PLAYER openstatechange="OnOpenStateChangeTransport(NewState);OnOpenStateChange();"
				playstatechange="OnPlayStateChangeTransport(NewState);OnPlayStateChange();"
				status_onchange="OnStatusChangeTransport(status);"
		        disconnect="OnDisconnectTransport();"
		        modechange="OnModeChange(ModeName, NewValue);">

			<NETWORK
				bufferingprogress_onchange="OnBufferingChangeTransport(network.bufferingProgress);"
				receptionquality_onchange="UpdateReceptionQuality(network.receptionQuality);"/>
				
		</PLAYER>

<!--
	Player Main Subview Area
-->

		<SUBVIEW id="svMain" left="250" top="0"
			width="JScript:view.width-svStub.width-svMain.left;"
			height="289"
			zIndex="10"
			verticalAlignment="stretch"
			horizontalAlignment="stretch"
			>
			
			<SUBVIEW id="svTop" left="0" top="0"
				width="346"
				height="33"
				horizontalAlignment="stretch"
				verticalAlignment="top">

				<SUBVIEW id="svTopLeft" left="0" top="0"
					width="299" height="JScript:svTop.height;"
					backgroundImage="player_top_left.bmp"
					transparencyColor="#FF00FF"
					horizontalAlignment="left">
					
					<BUTTONGROUP left="116" top="3"
						width="91" height="19"
						image="player_top_controls_left.bmp"
						downImage="player_top_controls_left_down.bmp"
						hoverImage="player_top_controls_left_hover.bmp"
						disabledImage="player_top_controls_left_disabled.bmp"
						mappingImage="player_top_controls_left_map.bmp">
						
						<BUTTONELEMENT id="bOpenFile" mappingColor="#815490"
							upToolTip="Open File"
							onClick="OpenMedia();"
							enabled="true"/>
						
						<BUTTONELEMENT id="bPlaylist" mappingColor="#A586B3"
							upToolTip="Show Playlist"
							downToolTip="Hide Playlist"
							onClick="TogglePlaylist();"
							sticky="true"
							enabled="true"/>
			
						<BUTTONELEMENT id="bVis" mappingColor="#D4BEDE"
							upToolTip="Next Visualization"
							onClick="vis.next();"
							enabled="wmpprop:vis.visible"/>
							
						<BUTTONELEMENT id="bEq" mappingColor="#E7D5EF"
							upToolTip="Show Equalizer"
							downToolTip="Hide Equalizer"
							onClick="ToggleEqualizer();"
							sticky="true"
							enabled="true"/>
					</BUTTONGROUP>
					
				</SUBVIEW>

				<SUBVIEW id="svTopMiddle" left="299" top="0"
